
# AWS Configuration
AWS_ACCOUNT_ID=""
AWS_DEFAULT_REGION=""

# The single S3 bucket the agent's read_s3_file/list_s3_files tools and
# IAM role are scoped to. Set this to the platform's signal-uploads
# bucket (see `SignalUploadsBucketName` stack output / the
# `signalUploadsBucket` field in aws-exports.json) so the agent can
# only read files uploaded through the platform, not any bucket in the
# account. Required by attach_agent_policies.sh, which substitutes it
# into policies/s3_access.json's `${AGENT_S3_BUCKET_NAME}` placeholder.
AGENT_S3_BUCKET_NAME=""

# Note: after deploying, also set aws.bedrock.guardrail_id and
# aws.bedrock.guardrail_version in config.yaml from the stack's
# AgentGuardrailId/AgentGuardrailVersion outputs, and grant
# bedrock:ApplyGuardrail (see policies/bedrock_access.json, which uses
# AWS_ACCOUNT_ID above) so the model is protected by a prompt-attack
# filter.
